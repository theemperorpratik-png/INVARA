<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>_INVARA_CREATE</title>
    <link rel="stylesheet" href="/css/create.css">
</head>

<body>
    <!-- for animation -->
    <div id="ani">
        <span id="anitxt">TELEPORTING</span>
    </div>
    <!-- for animation -->
    <!-- <div class="bimg"></div> -->
    <div class="header">
        <h1 class="logo">_INVARA</h1>
        <button id="ebutt"><-&nbsp; DOMAIN</button>
    </div>
    <div class="hmm">ART GENERATOR</div>
    <div class="main">
        <div class="canvas">
            <canvas id="canvas" width="1000" height="600"></canvas>
        </div>
        <div class="controls">
            <div class="sel">
                <label for="sysSelect">SYSTEM: </label>
                <select name="sysSelect" id="sysSelect">
                    <option value="fractal">FRACTAL GROWTH</option>
                    <option value="cosmic">COSMIC FEILD</option>
                    <!-- <option value="particle">PARTICLE FLOW</option>
                    <option value="geometry">GEOMETRIC GRID</option>
                    <option value="gilitch">GILITCH MATRIX</option>
                    <option value="liquid">LIQUID</option>
                    <option value="wave">WAVE FEILD</option>
                    <option value="orbit">ORBITAL SYSTEM</option>
                    <option value="cellular">CELLULAR AUTOMATA</option>
                    <option value="noise">NOISE TERRAIN</option>
                    <option value="reaction">REACTION DIFFUSION</option>
                    <option value="voronoi">VORONOI</option>
                    <option value="flow">FLOW MAP</option>
                    <option value="spiral">SPIRAL FIELD</option>
                    <option value="tunnel">INFINITE TUNNEL</option>
                    <option value="topography">TOPOGRAPHY</option>
                    <option value="network">NETWORK</option>
                    <option value="crystal">CRYSTAL GROWTH</option>
                    <option value="lightning">LIGHTNING</option>
                    <option value="hybrid">HYBRID</option> -->
                </select>
                <!-- just planning and writing bout these was way too boring it sucked -->
            </div>
            <div class="para">
                <div class="title">
                    <span>PARAMETERS FOR:</span>
                    <span id="sysName">COSMIC FEILD</span>
                </div>
                <div id="parameters">
                    <div id="cosmoh">
                        <div class="pinfo">
                            <div class="ugh">
                                <label for="density">DENSITY</label>
                                <!-- <label for="selFrac" class="frac"></label> -->

                            </div>
                            <input type="range" id="density" min="1" max="100" value="50"><span class="dVal">50</span>

                        </div>
                        <div class="pinfo">
                            <div class="ugh">
                                <label for="complexity">COMPLEXITY</label>

                            </div>
                            <input type="range" id="complexity" min="1" max="100" value="50"><span
                                class="cVal">50</span>

                        </div>
                        <div class="pinfo">
                            <div class="ugh">
                                <label for="scale">SCALE</label>
                            </div>
                            <input type="range" id="scale" min="1" max="100" value="50"><span class="sVal">50</span>

                        </div>
                    </div>
                    <div class="fractal">
                        <div class="pinfo">
                                <div class="ugh">
                                    <label for="fracType">SELECT FRACTAL</label>
                                    <select name="fracType" id="fracType">
                                        <option value="fracTree">FRACTAL TREE</option>
                                        <option value="set">MANDELBROT SET</option>
                                        <option value="koch">KOCH SNOWFLAKE</option>
                                    </select>
                                </div>
                            </div>
                        <div class="tree">
                            
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="backName">SELECT BACKGROUND</label>
                                    <select name="backName" id="backName">
                                        <option value="black">BLACK</option>
                                        <option value="white">WHITE</option>
                                        <option value="blue">BLUE</option>
                                        <option value="RED">RED</option>
                                    </select>

                                </div>

                            </div>
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="col">SELECT COLOR</label>
                                    <select name="col" id="col">
                                        <option value="white">WHITE</option>
                                        <option value="blue">BLUE</option>
                                        <option value="black">BLACK</option>
                                        <option value="RED">RED</option>
                                    </select>
                                </div>
                            </div>
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="angle">ANGLE</label>

                                </div>
                                <input type="range" id="angle" min="1" max="100" value="50">
                                <span class="cVal" id="angleVal">50</span>

                            </div>
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="complex">COMPLEXITY</label>

                                </div>
                                <input type="range" id="complex" min="1" max="100" value="50">
                                <span class="cVal" id="complexVal">50</span>

                            </div>
                        </div>
                        <div class="set">
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="it">ITERATIONS</label>

                                </div>
                                <input type="range" id="it" min="10" max="200" value="80">
                                <span class="cVal" id="itVal">80</span>

                            </div>
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="zoom">ZOOM</label>

                                </div>
                                <input type="range" id="zoom" min="1" max="50" value="1" step="0.1">
                                <span class="cVal" id="zoomVal">1</span>

                            </div>
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="xPos">X POSITION</label>

                                </div>
                                <input type="range" id="xPos" min="-2" max="1" value="-0.5" step="0.01">
                                <span class="cVal" id="xVal">-0.5</span>

                            </div>
                            <div class="pinfo">
                                <div class="ugh">
                                    <label for="yPos">Y POSITION</label>

                                </div>
                                <input type="range" id="yPos" min="-1.5" max="1.5" value="0" step="0.01">
                                <span class="cVal" id="yVal">0</span>

                            </div>
                        </div>
                    </div>
                    <div class="seed">
                        <input type="text" name="seed" id="seed" value="001">
                        <button id="rButt">↻</button>
                    </div>
                    <button id="genButt">GENERATE</button>
                </div>

            </div>

        </div>
    </div>
    <script src="/js/create.js"></script>
</body>

</html>